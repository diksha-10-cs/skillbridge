{
  "name": "skillbridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run backend\" \"npm run frontend\"",
    "dev": "npm start",
    "run": "npm start",
    "backend": "node backend/server.js",
    "backend:dev": "node --watch backend/server.js",
    "frontend": "npm run --prefix frontend dev",
    "build": "npm run --prefix frontend build",
    "provision:admin": "npm run --prefix backend provision:admin",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "concurrently": "^9.1.2"
  }
}
